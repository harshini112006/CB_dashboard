# Local MongoDB (docker compose up -d) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cb_dashboard
PORT=4000

# --- Optional ---
# Require login (enabled whenever AUTH_PASSWORD is set)
# AUTH_USER=admin
# AUTH_PASSWORD=change-me
# AUTH_SECRET=long-random-string
# Enables the "AI summary" button (LLM-written executive summary of the current view)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-5-5

# If you see "querySrv ECONNREFUSED" with an Atlas mongodb+srv:// URI, use a public DNS resolver:
# DNS_SERVERS=8.8.8.8,1.1.1.1
